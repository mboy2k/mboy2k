# Copy to .env and fill in real values
BROWSER_API_KEY=change-me-to-a-long-random-string
# Bind to localhost when the agent runs on the same box; use 0.0.0.0 to expose
HOST=127.0.0.1
PORT=8099

# Forward proxy (http + CONNECT) started together with the app.
PROXY_HOST=127.0.0.1
PROXY_PORT=8888
# Credentials the proxy asks for; PROXY_PASSWORD falls back to BROWSER_API_KEY.
PROXY_USER=hoplite
PROXY_PASSWORD=change-me-too
# Set to 1 to allow proxying to private/loopback targets (off by default).
PROXY_ALLOW_PRIVATE=0
# Set to 1 to run the browser API without the proxy listener.
PROXY_DISABLED=0
